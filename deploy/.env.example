# Copie para .env (no frodo: /srv/selah/.env) e preencha. Nunca versione o .env.

# Senha do Postgres do Selah (gere com: openssl rand -base64 24 | tr -d '/+=')
POSTGRES_PASSWORD=

# Chaves do Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato para os serviços de push (Google, Mozilla, Apple)
VAPID_SUBJECT=mailto:contato@selatech.com.br

# Login com Google: ID do cliente OAuth (Google Cloud Console > APIs e serviços > Credenciais).
# Não é segredo. Vazio desliga o login.
GOOGLE_CLIENT_ID=
